# Optional local Conda env — Streamlit Cloud uses requirements.txt + runtime.txt only (no conda).
#   conda env create -f environment.yml.example && conda activate nyc-tree-explorer
# Or: conda create -n nyc-tree-explorer python=3.12 && pip install -r requirements.txt
name: nyc-tree-explorer
channels:
  - conda-forge
dependencies:
  - python=3.12
  - pip
  - pip:
      - streamlit==1.41.1
      - pandas==2.2.3
      - pydeck==0.9.1
      - matplotlib==3.9.2
      - requests==2.32.3
      - pyarrow==23.0.1
